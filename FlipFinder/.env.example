# FlipFinder Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Anthropic (Claude API) ──────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Gmail) ───────────────────────────────────────────────────────────────
# Use a Gmail App Password, NOT your account password.
# Enable 2FA, then create an App Password at:
#   https://myaccount.google.com/apppasswords
EMAIL_FROM=youraddress@gmail.com
EMAIL_TO=youraddress@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Facebook Marketplace ────────────────────────────────────────────────────────
# Your Facebook login credentials (use a dedicated account if possible).
# The bot will log in to scrape Austin Marketplace listings.
FACEBOOK_EMAIL=your@facebook-account.com
FACEBOOK_PASSWORD=your_facebook_password

# ── Location ────────────────────────────────────────────────────────────────────
AUSTIN_ZIP=78701
SEARCH_RADIUS_MILES=30

# ── Deal filters ────────────────────────────────────────────────────────────────
MIN_PROFIT_THRESHOLD=30
MIN_ROI_THRESHOLD=20
MAX_BUY_PRICE=500
